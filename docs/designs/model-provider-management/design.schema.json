{
  "doc_meta": {
    "title": "模型、供应商与认证管理",
    "owners": [],
    "reviewers": []
  },
  "glossary": [
    {
      "term": "ModelSelection",
      "definition": "完整的 providerId + modelId 原子选择"
    },
    {
      "term": "TurnBinding",
      "definition": "单轮固定的选择和认证版本"
    }
  ],
  "requirement_summary": {
    "background": "当前仅启动时绑定模型，用户需要在微信和本机管理页切换并管理认证",
    "goals": [
      "供应商发现",
      "认证后选择模型",
      "持久用户默认",
      "帮助入口",
      "重新认证"
    ],
    "non_goals": [
      "未知命令自动纠错",
      "自然语言自动切换",
      "跨供应商自动fallback",
      "多账户同时路由"
    ],
    "constraints": [
      "未知语法原文交给 Agent",
      "凭证本机管理",
      "运行中任务不切换"
    ],
    "assumptions": [
      "单所有者共享 Pi 凭证",
      "微信管理命令沿用单 Turn 队列"
    ],
    "open_questions": [
      "各认证方式的 staging 和失败恢复验收",
      "跨协议历史兼容验证"
    ]
  },
  "overall_design": {
    "architecture_summary": "明确命令和 Admin 共用用例，Pi SDK 负责目录/认证/模型切换",
    "key_decisions": [
      {
        "decision": "选择原子提交，Turn 开始绑定",
        "rationale": "避免半轮换模型和不完整provider状态",
        "alternatives": [
          "立即修改运行中Session"
        ],
        "evidence_refs": [
          "Pi setModel",
          "RunNextTurn"
        ]
      },
      {
        "decision": "认证暂存并在provider空闲时提交",
        "rationale": "失败保留旧账户，避免多轮调用串账户",
        "alternatives": [
          "先logout再login"
        ],
        "evidence_refs": [
          "CredentialStore 注入接口"
        ]
      }
    ],
    "business_flow": "选择provider → 检查认证 → 显示模型 → 提交完整选择 → 下一轮setModel"
  },
  "detailed_design": {
    "modules": [
      {
        "name": "command-catalog",
        "responsibility": "命令语法、帮助和示例同源"
      },
      {
        "name": "select-model",
        "responsibility": "验证并原子保存用户模型选择"
      },
      {
        "name": "pi-provider-authentication",
        "responsibility": "暂存登录、凭证提交和runtime刷新"
      },
      {
        "name": "provider-request-gate",
        "responsibility": "认证替换时等待活动任务退出"
      }
    ],
    "file_structure": "见 design.md 4.6"
  },
  "api_contracts": {
    "interface_changes": [
