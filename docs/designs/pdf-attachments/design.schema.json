  "requirement_summary": {
    "background": "用户希望微信上传 PDF 简历，保存后交给模型分析并继续追问。现有链路仅接收文字和图片。",
    "goals": [
      "接收并保存 PDF",
      "支持上传后分析和后续引用",
      "记录下载与解析 Trace"
    ],
    "non_goals": [
      "本地 PDF 解析",
      "其他厂商适配",
      "文件回传",
      "长期记忆"
    ],
    "scope": "用户级文件库、跨 Session 查询、Codex 上传和 file_url 经 Pi onPayload 发送",
    "constraints": [
      "保持用户身份和沙箱边界",
      "保留消息去重与游标事务",
      "不修改运行代码"
    ],
    "assumptions": [
      "首版优先沿用当前模型认证",
      "文件保存至显式删除或管理员清理",
      "本文数值为建议配置"
