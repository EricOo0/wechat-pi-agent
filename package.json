{
  "name": "wechat-pi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/bootstrap/main.ts",
    "ilink:login": "tsx src/bootstrap/ilink-login.ts",
    "start": "node dist/bootstrap/main.js",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-sandbox-workers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "pino": "9.9.5",
    "prom-client": "15.1.3",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
